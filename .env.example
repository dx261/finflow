# FinFlow environment configuration.
# Copy to .env and adjust for your environment. Never commit real secrets.

# --- Application ---
APP_ENV=development
DEBUG=false
# Anonymous demo access; keep false for real financial data.
# The frontend reads this backend setting at runtime (no VITE flag needed).
DEMO_MODE=false
# Keep false for PostgreSQL / Docker deployment. For local SQLite use
# backend/.env.demo.example as backend/.env instead.
LOCAL_DEMO=false

# --- Backend ---
# JSON array of CORS origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_SIZE_MB=20

# --- PostgreSQL ---
POSTGRES_USER=finflow
POSTGRES_PASSWORD=finflow
POSTGRES_DB=finflow
POSTGRES_PORT=5432
# Connection string used by the backend.
# Inside Docker Compose the host is "postgres"; on the host it is "localhost".
DATABASE_URL=postgresql+asyncpg://finflow:finflow@localhost:5432/finflow

# --- Redis ---
REDIS_PORT=6379
# Use 127.0.0.1 (not "localhost") to avoid IPv6 ::1 resolution issues
# with the Celery/kombu broker on Windows.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Security (configure strong values in production) ---
SECRET_KEY=replace-with-at-least-32-random-characters
# Required by production. Leave blank in development; share only with invitees.
REGISTRATION_TOKEN=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
